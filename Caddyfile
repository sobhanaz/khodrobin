# DOMAINS is a space-separated list so one certificate request covers every
# name we answer on. IPv6 has its own name for now because some Iranian mobile
# networks route v6 better than v4.
{$DOMAINS} {
	encode zstd gzip

	# The reviewer may open this from Iran on a phone; keep the surface small
	# and the headers honest.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The Go service owns the data surface and the probes; Nuxt owns everything
	# a person sees. Same origin, so the browser makes no cross-origin request
	# and there is no CORS surface at all.
	# The auth service owns its own prefix. Split at the edge rather than
	# proxying through the search API: an outage in one must not take the other
	# down, and search stays anonymous.
	handle /api/auth/* {
		reverse_proxy auth:8081
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}
	handle {
		reverse_proxy web:3000
	}
}
