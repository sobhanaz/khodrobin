# DOMAINS is a space-separated list so one certificate request covers every
# name we answer on. IPv6 has its own name for now because some Iranian mobile
# networks route v6 better than v4.
{$DOMAINS} {
	encode zstd gzip

	# The reviewer may open this from Iran on a phone; keep the surface small
	# and the headers honest.
	header {
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options "nosniff"
		Referrer-Policy "strict-origin-when-cross-origin"
		Permissions-Policy "camera=(), microphone=(), geolocation=()"
		-Server
	}

	# The Go service owns the data surface and the probes; Nuxt owns everything
	# a person sees. Same origin, so the browser makes no cross-origin request
	# and there is no CORS surface at all.
	# The auth service owns its own prefix. Split at the edge rather than
	# proxying through the search API: an outage in one must not take the other
	# down, and search stays anonymous.
	handle /api/auth/* {
		reverse_proxy auth:8081
	}
	handle /api/* {
		reverse_proxy api:8080
	}
	handle /healthz {
		reverse_proxy api:8080
	}
	handle /readyz {
		reverse_proxy api:8080
	}
	# A deploy nobody can see is a deploy that did not happen.
	#
	# Nuxt marks its hashed bundles immutable for a year, which is right: the
	# filename changes when the contents do. The HTML document carried NO
	# Cache-Control at all, so browsers fell back to heuristic caching and kept
	# serving the previous document — which references the previous bundle
	# names, and those really are cached for a year. One missing header on one
	# response meant a visitor could sit on an entire old version of the site
	# indefinitely, while the server had been correct since the deploy landed.
	#
	# no-cache does not mean "do not store"; it means "revalidate before use",
	# so the document is still cheap on a repeat visit and never stale.
	@html {
		not path /_nuxt/* /fonts/* /favicon.svg /apple-touch-icon.png /og.png
	}
	header @html Cache-Control "no-cache"

	handle {
		reverse_proxy web:3000
	}
}
