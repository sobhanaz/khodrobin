# Postgres
POSTGRES_USER=khodrobin
POSTGRES_PASSWORD=change-me
POSTGRES_DB=khodrobin

# API
KHODROBIN_ADDR=:8080

# AI service — provider is a one-line switch (decision 3).
# ollama works offline and from Iran; the cloud providers need a non-Iranian IP.
AI_PROVIDER=ollama            # ollama | openai | anthropic | gemini
AI_MODEL=qwen2.5:7b
AI_DAILY_COST_CEILING_USD=5
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# Ingest — the only thing crossing from the Iranian crawler to the VPS
INGEST_TOKEN=change-me
# Salt for hashing public seller identifiers. Never store the raw value.
SELLER_HASH_SALT=change-me
